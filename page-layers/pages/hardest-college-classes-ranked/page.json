      "summary": {
        "selector": "#section---KeyTakeaways"
      },
      "backMatter": {
        "selector": "#section---Methodology"
      },
      "figures": {
        "number": "",
        "exclude": ""
      },
      "source": "Study.com Gen Ed Anxiety Survey, 2026",
      "components": {
        "copy-cite": {
          "pullStats": ""
        },
        "contents": {
          "ariaLabel": "Report contents",
          "labels": {
            "section---KeyTakeaways": "Key takeaways",
            "section---WhichSubjectsAreTheMostFearedEvenBeforeTheyWereTaken": "Most feared before class",
            "section---HardestCollegeCoursesRankedByExperiencedStressLevels": "Hardest, by stress",
            "section---EasiestGenEdClassesRankedByLeastAnxietyInducing": "Easiest classes",
            "section---SelfDoubtIsThePrimaryCauseOfGenEdAnxiety": "Self-doubt",
            "section---GenEdAnxietyAffectsCollegePerformanceAndOutcomes": "Grades and dropping out",
            "section---ExtraLearningHoursHelpStudentsCopeWithHardestCollegeCourses": "What helps students cope",
            "section---Students1TipForGenEdAnxietyAskForHelp": "Ask for help",
            "section---TheRealityItSMostlyNotTheSubjectItSTheSelfDoubt": "The bottom line",
            "section---Methodology": "Methodology"
          },
          "cta": {
            "text": "Dreading a gen ed? Take it online, at your own pace, for college credit.",
            "label": "General education courses",
            "href": "https://study.com/college/general-education.html"
          }
        },
        "stat-waffle": {
          "title": "Of every 100 students",
          "after": ".wiki-content > div > p.description",
          "views": [
            {
              "key": "math",
              "label": "Dreaded math",
              "tone": "data",
              "find": "(\\d+)% of respondents said they dreaded Math the most"
            },
            {
              "key": "doubt",
              "label": "Self-doubt",
              "tone": "ink",
              "find": "(\\d+)% of respondents cited"
            },
            {
              "key": "gpa",
              "label": "GPA hit",
              "tone": "signal",
              "find": "(\\d+)% stating their gen ed anxiety had an effect"
            },
            {
              "key": "quit",
              "label": "Quit thoughts",
              "tone": "risk",
              "find": "(\\d+)% saying they considered dropping out"
            }
          ]
        },
        "labels": {
          "items": [
            {
              "at": ".wiki-content > div > p.description",
              "where": "append",
              "parts": [
                "Study.com Gen Ed Anxiety Survey",
                "131 students and recent graduates"
              ],
              "class": "byline"
            },
            {
              "at": "#section---KeyTakeaways",
              "where": "prepend",
              "text": "At a glance",
              "class": "kicker",
              "decorative": true
            },
            {
              "at": "#section---Methodology",
              "where": "prepend",
              "text": "About the data",
              "class": "kicker",
              "decorative": true
            }
          ]
        }
      }
    },
    "newLook": {
      "header": ".cx-navigation, nav.cx-hub-nav, nav.study-nav",
      "group": ".cx-navigation__right, .cx-hub-nav__right, .cx-hub-nav__mobile-top-bar-right, .study-nav__main-actions",
      "before": ":scope > .cx-navigation__study-ai, :scope > .cx-hub-nav__search, :scope > .cx-hub-nav__mobile-top-bar-search, :scope > #searchBarDesktop, :scope > .search-form, :scope > .searchTrigger",

    "darkImages": {
      "scope": ".wiki-content img, nav.cx-hub-nav img, nav.study-nav img.breakthrough-logo, footer.e2-footer img, .cx-navigation__logo img",
      "logo": "nav img, footer.e2-footer .e2-footer__company-section, .cx-navigation__logo",
      "chart": "",
      "quote": ""
    }
  },
  "owner": "Content team",
  "notes": "Second pilot, on the College template (cxPromoArticleMain), to show the components are reusable: the same component code as the AI report, with this page's settings above and its own CSS in this folder. Figures are numbered in page order (the file names carry no number) and keep the captions the page already has. The charts are designed infographics with their own dark header, so in dark mode they sit on a light card instead of being recolored. The site serves this page with either the Eureka header (cx-hub-nav, one row per device) or the older study-nav header; signed-in readers get the Eureka 2 nav (.cx-navigation). The settings and chrome.css cover all three.",
  "expects": [
    {
      "selector": "body#cxPromoArticleMain",
      "count": 1,
      "why": "the scope every page rule starts with"
    },
    {
      "selector": "#mainContainer > .wiki-content",
      "count": 1,
      "why": "the article container the layout and every component use"
    },
